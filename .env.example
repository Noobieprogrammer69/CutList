# Copy to .env.local if needed. npm run dev / npm start load this for both services.
# Leave unset to store projects in this checkout's data directory.
# CUTLIST_DATA=/path/to/cutlist/data
CUTLIST_WORKER_URL=http://127.0.0.1:8000
CUTLIST_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Optional invitation gate, without accounts. Use a long random value.
CUTLIST_ACCESS_KEY=
# Use true behind an HTTPS reverse proxy; keep false for local HTTP.
CUTLIST_SECURE_COOKIE=false
# Optional alternate speech-model directory (default models/parakeet).
# CUTLIST_ASR_MODEL_DIR=/path/to/parakeet
# Long recordings are streamed to disk; this is a disk limit, not a RAM allocation.
CUTLIST_MAX_UPLOAD_GB=64
CUTLIST_ASR_THREADS=4
CUTLIST_ASR_BATCH=2
CUTLIST_ASR_CHUNK_SECONDS=20
# Free local meaning/setup/payoff review. Models are downloaded separately.
CUTLIST_OLLAMA_URL=http://127.0.0.1:11434
CUTLIST_EDITOR_MODEL=qwen3:1.7b
CUTLIST_EDITOR_TIMEOUT=180
# auto requests supported local Ollama GPU offload when a device is accessible.
# cpu forces CPU; gpu requests offload explicitly. This is not a speed guarantee.
CUTLIST_ACCELERATION=auto
CUTLIST_VISION_MODEL=qwen3-vl:2b
CUTLIST_VISION_TIMEOUT=240
CUTLIST_SEARCH_MODEL=embeddinggemma:300m
# Setup installs only whitelisted optional local components. Disable on hosted workers.
CUTLIST_ENABLE_SETUP=true
# Optional anonymous voice-label model (default models/speakers/embedding.onnx).
# CUTLIST_SPEAKER_MODEL=/path/to/embedding.onnx
