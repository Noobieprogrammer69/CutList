# Free CPU demo settings. Copy to .env.local on the cloud workspace only.
# Replace the origin with the exact public HTTPS URL, without a trailing slash.
CUTLIST_WEB_HOST=0.0.0.0
CUTLIST_WORKER_URL=http://127.0.0.1:8000
CUTLIST_ORIGINS=https://REPLACE_WITH_YOUR_PUBLIC_APP_HOST
CUTLIST_SECURE_COOKIE=true
CUTLIST_ENABLE_SETUP=false
# Shared invitation key; visitors do not need accounts.
CUTLIST_ACCESS_KEY=REPLACE_WITH_A_LONG_PRIVATE_PASSPHRASE
# A small per-file limit for a demo with a limited free storage allowance.
# Total recordings, models, dependencies, caches and exports also use storage.
CUTLIST_MAX_UPLOAD_GB=1
CUTLIST_ASR_THREADS=4
CUTLIST_ASR_BATCH=2
CUTLIST_OLLAMA_URL=http://127.0.0.1:11434
CUTLIST_EDITOR_MODEL=qwen3:1.7b
CUTLIST_EDITOR_TIMEOUT=600
CUTLIST_ACCELERATION=cpu
