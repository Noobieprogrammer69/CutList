{
  "name": "cutlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "test": ".venv/bin/python -m unittest discover -s worker/tests -v",
    "test:browser": "node tests/browser.mjs",
    "model:download": "node scripts/python.mjs scripts/download_model.py",
    "test:preview": "node tests/preview.mjs",
    "speech:download": "node scripts/python.mjs scripts/download_speech_model.py",
    "test:quality": ".venv/bin/python scripts/evaluate_quality.py",
    "test:speech": "CUTLIST_TEST_SPEECH=1 .venv/bin/python -m unittest discover -s worker/tests -p test_transcription.py -v",
    "editor:download": "node scripts/python.mjs scripts/setup_editor.py",
    "test:editor": "CUTLIST_TEST_EDITOR=1 .venv/bin/python -m unittest discover -s worker/tests -p test_semantic.py -v",
    "benchmark": "node scripts/python.mjs scripts/benchmark_local.py",
    "vision:download": "node scripts/python.mjs scripts/setup_optional.py vision",
    "tracking:install": "node scripts/python.mjs scripts/setup_optional.py tracking",
    "speakers:download": "node scripts/python.mjs scripts/setup_optional.py speakers",
    "benchmark:hardware": "node scripts/python.mjs scripts/benchmark_hardware.py",
    "search:download": "node scripts/python.mjs scripts/setup_optional.py search",
    "desktop": "node scripts/desktop.mjs",
    "desktop:install": "node scripts/install-desktop.mjs",
    "deploy:package": "node scripts/python.mjs scripts/package_deploy.py"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.56.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
